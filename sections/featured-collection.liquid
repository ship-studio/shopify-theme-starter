<section class="featured-collection">
  <div class="container">
    <div class="section-heading">
      <h2 class="section-heading__title">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- elsif section.settings.collection != blank -%}
          {{ section.settings.collection.title }}
        {%- else -%}
          {{ 'products.no_products' | t }}
        {%- endif -%}
      </h2>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="section-heading__link">
          {{ 'products.view_all' | t }}
        </a>
      {%- endif -%}
    </div>

    <ul class="product-grid" role="list">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <li>{% render 'product-card', card_product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>{% render 'product-card', card_product: blank %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection's name."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
