<header class="site-header">
  <div class="container site-header__inner">
    <button
      type="button"
      class="site-header__menu-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="visually-hidden">{{ 'general.navigation.menu' | t }}</span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__brand">
      {%- if section.settings.logo -%}
        {{
          section.settings.logo
          | image_url: width: 360
          | image_tag:
            widths: '180, 360',
            sizes: '180px',
            alt: shop.name,
            class: 'site-header__logo'
        }}
      {%- else -%}
        <span class="site-header__name">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- assign menu = section.settings.menu | default: linklists.main-menu -%}
    <nav id="site-nav" class="site-nav" data-nav>
      <ul class="site-nav__list">
        {%- for link in menu.links -%}
          <li>
            <a
              href="{{ link.url }}"
              class="site-nav__link{% if link.active %} is-active{% endif %}"
              {% if link.active %}aria-current="page"{% endif %}
            >
              {{- link.title -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" class="site-header__action">
        <span class="visually-hidden">{{ 'general.navigation.search' | t }}</span>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/>
          <path d="M12.5 12.5L16 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="site-header__action site-header__cart">
        {{ 'general.navigation.cart' | t }}
        <span class="site-header__cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Shown instead of the store name."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
