<section class="blog">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">{{ blog.title }}</h1>
    </header>

    {% paginate blog.articles by 6 %}
      {%- if blog.articles.size > 0 -%}
        <ul class="article-grid" role="list">
          {%- for article in blog.articles -%}
            <li>
              <article class="article-card">
                <a href="{{ article.url }}" class="article-card__link">
                  {%- if article.image -%}
                    <div class="article-card__media">
                      {{
                        article.image
                        | image_url: width: 800
                        | image_tag:
                          widths: '400, 600, 800, 1200',
                          sizes: '(min-width: 750px) 33vw, 100vw',
                          alt: article.image.alt,
                          class: 'article-card__image',
                          loading: 'lazy'
                      }}
                    </div>
                  {%- endif -%}
                  <p class="article-card__date">
                    {{ article.published_at | date: '%B %-d, %Y' }}
                  </p>
                  <h2 class="article-card__title">{{ article.title }}</h2>
                  {%- if article.excerpt_or_content != blank -%}
                    <p class="article-card__excerpt">
                      {{ article.excerpt_or_content | strip_html | truncate: 140 }}
                    </p>
                  {%- endif -%}
                  <span class="article-card__more">{{ 'blog.read_more' | t }}</span>
                </a>
              </article>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="empty-state">{{ 'blog.empty' | t }}</p>
      {%- endif -%}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
