<section class="collections-list">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">{{ 'collections.title' | t }}</h1>
    </header>

    {% paginate collections by 12 %}
      <ul class="collection-grid" role="list">
        {%- for collection in collections -%}
          <li>
            <a href="{{ collection.url }}" class="collection-card">
              <div class="collection-card__media">
                {%- if collection.featured_image -%}
                  {{
                    collection.featured_image
                    | image_url: width: 600
                    | image_tag:
                      widths: '300, 450, 600, 900',
                      sizes: '(min-width: 750px) 33vw, 50vw',
                      alt: collection.featured_image.alt,
                      class: 'collection-card__image',
                      loading: 'lazy'
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
                {%- endif -%}
              </div>
              <h2 class="collection-card__title">{{ collection.title }}</h2>
              <p class="collection-card__count">
                {{ 'collections.products_count' | t: count: collection.all_products_count }}
              </p>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
