<section class="password-screen">
  <div class="password-screen__inner">
    <p class="password-screen__shop">{{ shop.name }}</p>
    <h1 class="password-screen__title">{{ 'general.password.opening_soon' | t }}</h1>
    <p class="password-screen__text">{{ 'general.password.message' | t }}</p>

    {% form 'storefront_password', class: 'password-screen__form' %}
      {%- if form.errors -%}
        <p class="form-error">{{ form.errors.messages.form }}</p>
      {%- endif -%}
      <label class="visually-hidden" for="password-input">
        {{ 'general.password.password_label' | t }}
      </label>
      <input
        type="password"
        id="password-input"
        name="password"
        placeholder="{{ 'general.password.password_label' | t }}"
        class="password-screen__input"
      >
      <button type="submit" class="button button--primary">
        {{ 'general.password.enter' | t }}
      </button>
    {% endform %}

    <p class="password-screen__note">{{ 'general.password.powered_by' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
