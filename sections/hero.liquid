<section class="hero{% if section.settings.image %} hero--with-image{% endif %}">
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.image -%}
      <div class="hero__media">
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            alt: section.settings.image.alt,
            class: 'hero__image'
        }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to your new store"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading",
      "default": "Tell visitors what you sell and why it matters, in one sentence."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Shown beside the text on desktop."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
