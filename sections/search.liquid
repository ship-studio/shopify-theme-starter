<section class="search">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">{{ 'search.title' | t }}</h1>
    </header>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
      <label class="visually-hidden" for="search-input">{{ 'search.placeholder' | t }}</label>
      <input
        type="search"
        id="search-input"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        class="search__input"
      >
      <button type="submit" class="button button--primary">{{ 'search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {% paginate search.results by 12 %}
        {%- if search.results.size > 0 -%}
          <p class="search__count">
            {{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}
          </p>

          <ul class="product-grid" role="list">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', card_product: item %}
                {%- else -%}
                  <article class="result-card">
                    <h3 class="result-card__title">
                      <a href="{{ item.url }}">{{ item.title }}</a>
                    </h3>
                  </article>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination">
              {{ paginate | default_pagination }}
            </nav>
          {%- endif -%}
        {%- else -%}
          <p class="empty-state">{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}
      {% endpaginate %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
